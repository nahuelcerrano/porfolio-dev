---
import LinkInline from "@/components/ui/LinkInline.astro"
import type { TimelineEntry } from "@/data/timeline"

type Props = TimelineEntry

const { title, subtitle, description, highlights, link, date } = Astro.props
---

<div
  class="relative ml-12 mr-2 pb-12 grid md:mx-12 before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-6 md:pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-yellow-400 -left-[42px] absolute rounded-full text-5xl" aria-hidden="true"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-yellow-400">{title}</h3>
      <p class="text-xl font-semibold text-white">{subtitle}</p>
      <time class="text-sm text-white/80">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-3 pb-4 text-gray-300 md:col-span-3">
    {description && <p>{description}</p>}
    {
      highlights && (
        <ul class="pl-5 space-y-1 list-disc marker:text-yellow-400/80">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    {
      link && (
        <LinkInline href={link}>
          Saber más
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
