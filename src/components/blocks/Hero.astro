---
import { Image } from "astro:assets"

import Badge from "@/components/ui/Badge.astro"
import SocialPill from "@/components/ui/SocialPill.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import Github from "@/icons/Github.astro"
import Mail from "@/icons/Mail.astro"
import profileImg from "@/assets/profile.png"
import { SITE } from "@/data/site"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <Image
      class="object-cover object-top rounded-full shadow-lg size-16"
      src={profileImg}
      width={128}
      alt={`Foto de ${SITE.name}`}
      loading="eager"
    />

    <a
      href={SITE.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para ofertas</Badge>
    </a>
  </div>

  <h1 class="pb-6 text-3xl font-bold text-white md:text-4xl lg:text-5xl lg:pb-10">
    Hey, soy Nahuel
  </h1>
  <p class="text-xl text-gray-300 [&>strong]:text-yellow-200 [&>strong]:font-semibold">
    <strong>Estudiante de Ingeniería en Sistemas y Desarrollador de Software.</strong>
    Construyo aplicaciones web full stack y, como pasante de investigación en CAETI - UAI,
    trabajo en robótica bípeda, firmware y programación de bajo nivel.
  </p>

  <nav aria-label="Redes y contacto" class="flex flex-wrap gap-4 mt-8">
    <SocialPill href={SITE.linkedin}>
      <LinkedIn class="size-4 md:size-6" />
      LinkedIn
    </SocialPill>
    <SocialPill href={SITE.github}>
      <Github class="size-4 md:size-6" />
      GitHub
    </SocialPill>
    <SocialPill href={`mailto:${SITE.email}`}>
      <Mail class="size-4 md:size-6" />
      {SITE.email}
    </SocialPill>
  </nav>
</div>
