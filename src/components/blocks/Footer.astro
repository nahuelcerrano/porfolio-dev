---
import { SITE } from "@/data/site"

const currentYear = new Date().getFullYear()
---

<footer class="container flex justify-center w-full px-4 mx-auto mt-16 mb-10 opacity-80 lg:max-w-4xl md:max-w-2xl">
  <div class="w-full py-4 md:flex md:items-center md:justify-between">
    <span class="text-sm text-zinc-200/90">
      Idea original de
      <a href="https://midu.dev/" target="_blank" rel="noopener noreferrer" class="hover:underline">midudev</a>.
      Casi todos los derechos reservados © {currentYear}
    </span>
    <ul class="flex flex-wrap items-center mt-3 text-sm font-medium gap-x-4 text-white/90 md:gap-x-6 md:mt-0">
      <li>
        <a href="/#sobre-mi" class="hover:underline">Sobre mí</a>
      </li>
      <li>
        <a href={`mailto:${SITE.email}`} class="hover:underline">Contacto</a>
      </li>
    </ul>
  </div>
</footer>
