---
import { SKILLS } from "@/data/skills"
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    SKILLS.map(({ title, items }) => (
      <div class="p-5 border rounded-xl border-white/10 bg-white/[0.03]">
        <h3 class="mb-3 font-semibold text-yellow-400">{title}</h3>
        <ul class="flex flex-wrap gap-2">
          {items.map((item) => (
            <li class="px-3 py-1 text-sm text-gray-200 bg-gray-800 border border-gray-700 rounded-full">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
