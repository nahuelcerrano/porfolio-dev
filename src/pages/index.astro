---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/ui/SectionContainer.astro"
import SectionTitle from "@/components/ui/SectionTitle.astro"
import Timeline from "@/components/ui/Timeline.astro"
import Hero from "@/components/blocks/Hero.astro"
import Projects from "@/components/blocks/Projects.astro"
import Skills from "@/components/blocks/Skills.astro"
import AboutMe from "@/components/blocks/AboutMe.astro"
import Briefcase from "@/icons/Briefcase.astro"
import Code from "@/icons/Code.astro"
import Tools from "@/icons/Tools.astro"
import Studies from "@/icons/Studies.astro"
import ProfileCheck from "@/icons/ProfileCheck.astro"
import { EXPERIENCE, EDUCATION } from "@/data/timeline"
---

<Layout>
  <main class="px-4">
    <SectionContainer id="inicio" class="py-16 md:pb-36">
      <Hero />
    </SectionContainer>

    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <SectionTitle>
          <Briefcase slot="icon" class="size-7" />
          Experiencia
        </SectionTitle>
        <Timeline entries={EXPERIENCE} />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <SectionTitle>
          <Code slot="icon" class="size-7" />
          Proyectos
        </SectionTitle>
        <Projects />
      </SectionContainer>

      <SectionContainer id="habilidades">
        <SectionTitle>
          <Tools slot="icon" class="size-7" />
          Habilidades
        </SectionTitle>
        <Skills />
      </SectionContainer>

      <SectionContainer id="estudios">
        <SectionTitle>
          <Studies slot="icon" class="size-7" />
          Estudios
        </SectionTitle>
        <Timeline entries={EDUCATION} />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <SectionTitle>
          <ProfileCheck slot="icon" class="size-7" />
          Sobre mí
        </SectionTitle>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
